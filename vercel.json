{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile && pnpm --dir frontend install --frozen-lockfile",
  "buildCommand": "pnpm --dir frontend build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/gateway.mjs": {
      "maxDuration": 120
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/gateway?__wewise_path=:path*"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ]
}
