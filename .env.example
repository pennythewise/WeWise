# Keep actual credentials in .env (ignored), never src/ or VITE_* variables.
# WorkBuddy Token Hub guide, page 3. Confirm actual account endpoint/model ID.
AI_PROVIDER=openai_compatible
AI_ENDPOINT=https://tokenhub.tencentmaas.com/plan/v3/chat/completions
AI_BASE_URL=https://tokenhub.tencentmaas.com/plan/v3
AI_MODEL=
AI_API_KEY=
# Alternative direct Claude prototype (AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
# Set 1 to enforce retrieval-only, overriding ALL model credentials.
# Public deployment loads operator-owned providers.json outside the checkout.
WEWISE_RETRIEVAL_ONLY=0
WEWISE_CLAUDE_DAILY_LIMIT=200
WEWISE_JEV_DAILY_LIMIT=400
WEWISE_COMPATIBLE_DAILY_LIMIT=200
# Local synthetic-only demo accounts; disable for external deployments.
WEWISE_SEED_DEMO=1
# Creates one isolated synthetic workspace per click; no shared login required.
WEWISE_DEMO_WORKSPACES=1
COOKIE_SECURE=0
# Public HTTPS preview: production, COOKIE_SECURE=1, exact HTTPS origin(s).
WEWISE_ENV=development
WEWISE_ALLOWED_ORIGINS=
# Optional private Tencent MemoryCore sidecar (server credentials only)
TENCENT_MEMORY_URL=
TDAI_GATEWAY_API_KEY=

# Explicit operator-installed, pinned ONNX assets; never downloads on requests.
# scripts/setup-embeddings.py --directory <private-model-directory>
WEWISE_EMBEDDING_DIR=
# Separate valid TypeSafe credential required. Retrieval-only blocks it.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
